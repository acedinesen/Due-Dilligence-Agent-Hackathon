# Copy this file to .env and fill in real values. Never commit .env.

# --- Claude API -------------------------------------------------------
# Currently unused by Track A (triage now goes through OpenRouter below);
# reserved for Track B's deep-research calls.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- OpenRouter (Track A triage LLM call) -------------------------------
# Required by app/triage.py (TriageAgent).
OPENROUTER_API_KEY=
# Free model; override to point at a different OpenRouter model slug.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# --- Track A: Google Drive trigger, triage & flagging ------------------
# Paste the full service-account key JSON content on one line (not a file
# path) — this lets the pipeline run on Railway with no mounted file.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Folder IDs from scripts/setup_drive_folders.py.
DRIVE_INBOX_ID=
DRIVE_RELEVANT_ID=
DRIVE_REVIEW_ID=
DRIVE_NOT_RELEVANT_ID=
# Which firm_profiles/<id>.json to load once at pipeline startup.
PIPELINE_FIRM_PROFILE=generic_seed
# How often (seconds) the poller checks Inbox/ for new decks.
PIPELINE_POLL_INTERVAL_SECONDS=45.0

# --- Existing Railway PDF reader adapter --------------------------------
PDF_READER_URL=https://pdfreader-production-29d1.up.railway.app
PDF_READER_PATH=/parse
PDF_READER_TIMEOUT_SECONDS=90.0

# --- Supabase (used elsewhere in the app; unrelated to Track A) --------
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=pitch-decks

# --- Attio CRM (delivery: app/adapters/attio_client.py) -----------------
# Workspace API key from Attio → Workspace settings → Developers. Exactly 64 chars.
ATTIO_API_KEY=

# --- Slack delivery (app/adapters/slack_notifier.py) --------------------
# Preferred path: one Incoming Webhook URL. This URL *is* the credential —
# anyone holding it can post to the channel — so keep it out of logs and git.
# Slack app config -> Incoming Webhooks -> Add New Webhook to Workspace.
SLACK_WEBHOOK_URL=
# Alternative path (only if the team already has a Slack app): a bot token
# with the chat:write scope, plus the target channel's encoded ID (e.g.
# C0123456789 — Slack channel -> View channel details -> bottom of About).
# Both are required together. SLACK_WEBHOOK_URL, if set, takes precedence.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
